# MongoDB Atlas connection string
# Replace with your own MongoDB connection string
ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Server port
PORT=5050

# JWT Secret Key
# ⚠️ IMPORTANT: Use a strong random string in production!
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-and-random-secret-key-change-this-in-production

